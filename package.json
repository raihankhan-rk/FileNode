{
  "name": "filenode-server",
  "version": "0.1.0",
  "description": "Ultra-lightweight local file server for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "filenode": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "file-server",
    "api",
    "agents",
    "ai-agents",
    "local-files",
    "lightweight",
    "hono",
    "bun",
    "openclaw",
    "filesystem"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/raihankhan/filenode"
  },
  "homepage": "https://github.com/raihankhan/filenode#readme",
  "bugs": {
    "url": "https://github.com/raihankhan/filenode/issues"
  },
  "license": "MIT",
  "author": "raihan khan",
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun --sourcemap && bun build src/index.ts --outdir dist --target bun --sourcemap",
    "dev": "bun run src/cli.ts start",
    "start": "bun run src/cli.ts start",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun test && bun run build"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "zod": "^3.24.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
